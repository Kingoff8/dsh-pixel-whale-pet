{
  "name": "dsh-pixel-whale-pet",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A pixel whale calf that swims through empty space in the chat, dodges text and the cursor, reacts to every working stage and task, spouts water, wears headphones and launches a firework when the turn completes.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kingoff8/dsh-pixel-whale-pet.git"
  },
  "homepage": "https://github.com/Kingoff8/dsh-pixel-whale-pet#readme",
  "bugs": {
    "url": "https://github.com/Kingoff8/dsh-pixel-whale-pet/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pet",
    "pixel-art",
    "whale",
    "overlay"
  ]
}
